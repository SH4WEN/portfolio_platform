# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (Neon PostgreSQL)
# For local dev without PostgreSQL, SQLite fallback will be used automatically if DATABASE_URL is empty
DATABASE_URL=postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
